# ============================================================
# TG2Cloud NAS 精简版 —— 环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# 建议用脚本生成：python scripts/gen-env.py config.plain.env > .env
# 注意：含 B64 后缀的字段存放 Base64 编码值（编码≠加密，等价于明文保管）
# ============================================================

# ---------- Telegram 机器人（必填） ----------
# 从 @BotFather 获取 Bot Token
BOT_TOKEN_B64=
# 从 https://my.telegram.org 获取 api_id / api_hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH_B64=
# 只允许这个 Telegram 数字 ID 私聊使用 Bot
ALLOWED_USER_ID=
# Telegram 专用代理（可留空=直连）。仅作用于 TG 连接与 TG 文件下载，不影响 rclone。
# 支持 http / socks5 / socks4，明文 URL 填写，含认证示例：http://user:pass@192.168.1.10:7890
# 注意：不要设置全局 HTTP_PROXY/HTTPS_PROXY，否则 rclone 也会被带上代理。
TG_PROXY_URL=

# ---------- 存储网关（必填） ----------
# 存储后端：固定为 openlist
TG2CLOUD_STORAGE_BACKEND=openlist
# rclone 远端名：固定为 openlist（与后端绑定，勿改）
TG2CLOUD_RCLONE_REMOTE_NAME=openlist
# OpenList 的 WebDAV 地址，注意结尾 /dav
#   OpenList 与 Bot 同机（宿主机）时：http://host.docker.internal:5244/dav
#   OpenList 在另一台机器时：http://<OpenList的IP>:5244/dav
WEBDAV_URL_B64=
# 在 OpenList 后台为该 Bot 创建的专用 WebDAV 用户名/密码
WEBDAV_USERNAME_B64=
WEBDAV_PASSWORD_B64=
# 可选：WebDAV 用户根目录之下的子目录（相对路径，留空表示直接写入用户根目录）
WEBDAV_TARGET_PATH_B64=

# ---------- 容量与调度（可选，保持默认即可） ----------
# 本地落盘预算（GB）；超过该值的单文件自动走流式直传
LOCAL_TEMP_BUDGET_GB=20
# 磁盘最少保留（GB），低于该安全线不再放行普通落盘任务
MIN_FREE_DISK_GB=8
# 时区
TZ=Asia/Shanghai

# ---------- 高级调度参数（可选，一般无需修改） ----------
# CONTROL_INTERVAL_SECONDS=3
# CPU_TARGET_LOW_PERCENT=60
# CPU_TARGET_HIGH_PERCENT=80
# CPU_PRESSURE_PERCENT=90
# MEMORY_SOFT_MIN_MB=1024
# MEMORY_HARD_MIN_MB=512
# RAMP_UP_STEP=1
# RAMP_DOWN_FACTOR=0.5
# MAX_RETRIES=3
# REMOTE_HEALTH_INTERVAL_SECONDS=30

# ---------- OpenList 单独部署时使用（docker-compose.openlist.yml） ----------
# 首次初始化 OpenList 的管理员密码（仅全新数据目录首次生效）
OPENLIST_ADMIN_PASSWORD=
