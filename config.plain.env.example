# TG2Cloud NAS 精简版 —— 明文配置模板
# 用法：
#   cp config.plain.env.example config.plain.env
#   # 填写下面的明文值（无需自己编码）
#   python scripts/gen-env.py config.plain.env > .env
#
# 本文件与生成的 .env 均含敏感信息，已在 .gitignore 中忽略，切勿提交。

# ---------- Telegram 机器人 ----------
# @BotFather 提供的 Bot Token
BOT_TOKEN=
# https://my.telegram.org 提供的 api_id 与 api_hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 仅允许该 Telegram 数字 ID 私聊使用
ALLOWED_USER_ID=

# ---------- 存储网关（OpenList） ----------
# OpenList WebDAV 地址（结尾 /dav）
#   同机（宿主机运行 OpenList）：http://host.docker.internal:5244/dav
#   另一台机器：http://<OpenList的IP>:5244/dav
WEBDAV_URL=
# 为该 Bot 在 OpenList 创建的专用 WebDAV 用户
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
# 可选：用户根目录下的子目录（留空表示写入用户根目录）
WEBDAV_TARGET_PATH=

# ---------- 容量与调度（可选） ----------
LOCAL_TEMP_BUDGET_GB=20
MIN_FREE_DISK_GB=8
TZ=Asia/Shanghai

# ---------- OpenList 首次部署管理员密码（可选） ----------
OPENLIST_ADMIN_PASSWORD=
